rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write access to all documents (development mode)
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Trademarks collection
    match /trademarks/{trademarkId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Licenses collection
    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Ratings collection
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Admin logs collection
    match /adminLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
